    background: #172033;

    color: white;

    text-align: center;

    padding: 25px 15px;
}

footer p {
    margin: 4px 0;
}

/* =========================
   ANIMATION
========================= */

@keyframes openBox {

    from {
        opacity: 0;
        transform: translateY(-8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}

/* =========================
