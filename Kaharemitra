    margin-bottom: 22px;
}

.section-title h2 {
    color: #07549b;
}

/* =========================
   SERVICE CARDS
========================= */

.service-grid {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(180px, 1fr));

    gap: 18px;
}

.service-card {
    background: white;
    border-radius: 18px;
    padding: 25px 15px;
    text-align: center;
    cursor: pointer;

    border: 1px solid #e5eaf0;

    box-shadow:
