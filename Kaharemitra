    transition: 0.25s;
}

.service-card:hover {
    transform: translateY(-5px);

    box-shadow:
        0 10px 28px rgba(0,0,0,0.13);
}

.service-icon {
    font-size: 45px;
    margin-bottom: 10px;
}

.service-card h3 {
    font-size: 18px;
    color: #172033;
}

/* =========================
   SERVICE LIST
========================= */

.service-list {
    display: none;

    background: white;

    margin-top: 20px;
    padding: 25px;

    border-radius: 18px;

    box-shadow:
        0 5px 20px rgba(0,0,0,0.08);

    animation: openBox 0.25s ease;
}

.service-list.active {
    display: block;
}

.service-list h2 {
    color: #07549b;
    margin-bottom: 18px;
}

.service-items {
    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));

    gap: 12px;

    list-style: none;
}

.service-items li {
    background: #eef6fb;

    padding: 13px;

    border-radius: 10px;

    border-left: 4px solid #078b8b;

    font-size: 15px;
}

/* =========================
   ADDRESS
========================= */

.address-box {
    margin-top: 30px;

    background: #fff8df;

    padding: 20px;

    border-radius: 15px;

    text-align: center;

    border: 1px solid #f1df9c;
}

.address-box h3 {
    color: #8a6500;
    margin-bottom: 8px;
}

/* =========================
   CONTACT BOX
========================= */

.contact-box {
    margin-top: 20px;

    background: white;

    padding: 25px;

    text-align: center;

    border-radius: 16px;

    box-shadow:
        0 5px 20px rgba(0,0,0,0.07);
}

.contact-box a {
    color: #07549b;
    font-weight: bold;
    text-decoration: none;
}

/* =========================
   FOOTER
========================= */

footer {
