========================= -->

<script>

function showService(serviceId) {

    // सभी service sections बंद करें

    const allServices =
        document.querySelectorAll(".service-list");

    allServices.forEach(function(section) {

        section.classList.remove("active");

    });


    // जिस service पर click किया है उसे खोलें

    const selected =
        document.getElementById(serviceId);


    if (selected) {

        selected.classList.add("active");


        // मोबाइल पर section तक automatically जाएं

        setTimeout(function() {

            selected.scrollIntoView({

                behavior: "smooth",

                block: "nearest"

            });

        }, 100);

    }

}

</script>


